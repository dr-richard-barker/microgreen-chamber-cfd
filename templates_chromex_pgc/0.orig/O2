FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      O2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.2095; // Initial 20.95% O2

boundaryField
{
    inlet_port
    {
        type            fixedValue;
        value           uniform 0.2095;
    }

    exhaust_ports
    {
        type            inletOutlet;
        inletValue      uniform 0.2095;
        value           uniform 0.2095;
    }

    "(floor|walls|lid)"
    {
        type            zeroGradient;
    }
}
